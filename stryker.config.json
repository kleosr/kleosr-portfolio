{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test/**"
  ],
  "ignorePatterns": ["coverage", "dist", "reports", "public"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "reporters": ["clear-text", "progress", "html"],
  "timeoutMS": 10000,
  "disableTypeChecks": true
}
