{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --reporter=dot"
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test/**"
  ],
  "ignorePatterns": ["coverage", "dist", "reports", "public"],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "reporters": ["clear-text", "progress", "html"],
  "timeoutMS": 30000,
  "concurrency": 4,
  "disableTypeChecks": true
}
