{
  "name": "kleosr-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "snapshot": "node scripts/snapshot-github.mjs",
    "build": "node scripts/snapshot-github.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/main.tsx src/grok-main.tsx src/App.tsx src/components src/hooks src/vision src/data src/content.ts src/grok-content.ts vite.config.ts",
    "check": "tsc -b && pnpm lint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "puppeteer-core": "^25.8.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
