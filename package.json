{
  "name": "kleosr-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "snapshot": "node scripts/snapshot-github.mjs",
    "build": "node scripts/snapshot-github.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts vitest.config.ts",
    "check": "tsc -b && pnpm lint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "deadcode": "knip",
    "metrics": "node scripts/quality-gates.mjs",
    "mutate": "stryker run",
    "quality": "pnpm check && pnpm coverage && pnpm deadcode && pnpm metrics && pnpm mutate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "puppeteer-core": "^25.8.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
